# ReguLens — the one file you edit.
#
#   cp regulens.env.example regulens.env
#   # set PROJECT_ID (and GEMINI_API_KEY if you have one)
#   bash scripts/quickstart.sh
#
# Every script and both Cloud Run services read this file. Nothing else needs
# editing: the *.run.app URLs are read back from Cloud Run after the deploy,
# never pasted in by hand.
#
# regulens.env itself is gitignored. Keep your key out of the repo.

# ---------------------------------------------------------------- required ---

# Your Google Cloud project. Billing must be linked and you need Owner (or
# enough to create service accounts, Pub/Sub topics and IAM bindings).
PROJECT_ID=your-project-id

# ---------------------------------------------------------------- optional ---

# Where the infrastructure lives. Cloud Run, Firestore, Pub/Sub, GCS and the
# embedding model all use this. Generation is a global endpoint regardless.
REGION=asia-southeast1

# A Gemini Developer API key from https://aistudio.google.com/apikey.
#
# Optional. Leave it empty and every model call goes to Vertex AI, which works
# identically and bills per token. Set it and the same calls go to the Gemini
# Developer API, whose free tier covers the models this project uses.
#
# The key must come from a project with NO billing account linked — linking
# billing promotes the key to the paid tier and the free allowance disappears.
GEMINI_API_KEY=

# The key country discovery calls Gemma with.
#
# Optional, and separate from GEMINI_API_KEY on purpose. Gemma is served by the
# Gemini Developer API and not by Vertex, so discovery needs a key even when the
# rest of the stack runs on Vertex. Setting GEMINI_API_KEY instead would move
# every call over, embeddings included — and Developer API vectors are not
# comparable with Vertex vectors, so every clause already stored would silently
# stop matching.
#
# Leave it empty and discovery says it is not configured; the panel stays
# hidden rather than offering a button that always fails. When you are already
# on the Developer API, GEMINI_API_KEY is used and this can stay empty.
# DISCOVERY_API_KEY=

# The model. Must be Gemini 3.5 or newer for the hackathon rules.
GEMINI_MODEL=gemini-3.5-flash

# Upload bucket. Bucket names are globally unique; the default derives one from
# your project id, which is already unique. Override only if that name is taken.
# UPLOADS_BUCKET=your-project-id-uploads

# Turn on GET /debug/documents/{id}: stage log, rejected candidates, guardrail
# decisions, confidence components. Useful while developing, off in production.
DEBUG_VIEW=true

# Watched sources — the addresses ReguLens re-reads on a schedule.
#
# Every value below has a working default; none of this has to be set. They are
# here because the two that matter are judgement calls a deployer may want to
# make differently.
#
# How often a newly registered address is re-read. The floor on noticing a
# change is this number: no regulator in the corpus publishes a webhook, so the
# only alternative to polling is waiting for somebody to notice by hand.
# SOURCE_CHECK_INTERVAL_HOURS=24
#
# Most feed entries read in one run. A regulator publishing ten things
# overnight would otherwise be ten extraction runs before anyone is awake to
# see the bill; the rest are left unread and come back on the next run.
# SOURCE_MAX_NEW_PER_CHECK=3
#
# A watched document longer than this is refused with a reason, never
# truncated. A confident answer drawn from the half of a regulation that
# happened to fit is worse than no answer.
# MAX_FETCH_CHARS=200000
